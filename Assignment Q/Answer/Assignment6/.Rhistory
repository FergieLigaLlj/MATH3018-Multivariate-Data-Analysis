# Load data
data <- read.table("data.txt", header = FALSE,sep = "\t")
# (a) Sample covariance matrix and PCs
S <- cov(data)
pca <- prcomp(data, scale. = FALSE)
summary(pca)
eigenvalues <- pca$sdev^2
print("Principal Components:")
print(pca$rotation)
print("Variances:")
print(eigenvalues)
# (b) Proportion of variance explained by first three PCs
prop_var <- sum(eigenvalues[1:3]) / sum(eigenvalues)
cat("Proportion explained by first three PCs:", prop_var, "\n")
# (c) Bonferroni 90% confidence intervals for lambda_1, lambda_2, lambda_3
n <- nrow(data)
alpha <- 0.1 / 3  # Bonferroni correction
z <- qnorm(1 - alpha / 2)
ci_lower <- eigenvalues[1:3] / (1 + z * sqrt(2 / n))
ci_upper <- eigenvalues[1:3] / (1 - z * sqrt(2 / n))
cat("90% Bonferroni CIs for lambda_1, lambda_2, lambda_3:\n")
for (i in 1:3) {
cat(sprintf("Lambda_%d: [%f, %f]\n", i, ci_lower[i], ci_upper[i]))
}
# (d) Dimensionality assessment
cat("Assessment: If prop_var > 0.8 and later eigenvalues are small, data may be summarized in fewer dimensions.\n")
View(data)
